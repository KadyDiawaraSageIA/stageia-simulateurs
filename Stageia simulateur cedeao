          '🚨 Budget insuffisant. Cherchez du financement additionnel avant de vous lancer.';

  el.innerHTML='<div class="box '+statut+'" style="margin-bottom:12px">'+msg+'</div>'+
    '<div class="kpis"><div class="kpi"><b>'+fm(budget)+'</b><span>Votre budget (F)</span></div>'+
    '<div class="kpi"><b>'+fm(totMin)+'</b><span>Budget minimum (F)</span></div>'+
    '<div class="kpi"><b>'+fm(totRec)+'</b><span>Budget recommandé (F)</span></div>'+
    '<div class="kpi"><b>'+(budget>=totMin?'✅ OK':'❌ Insuffisant')+'</b><span>Statut</span></div></div>'+
    '<table class="budget-table"><thead><tr><th>Poste de dépense</th><th>Minimum (F)</th><th>Recommandé (F)</th></tr></thead><tbody>'+
    postes.map(function(p){
      return '<tr><td>'+p.poste+'</td><td>'+fm(p.min)+'</td><td>'+fm(p.rec)+'</td></tr>';
    }).join('')+
    '<tr class="tot"><td><b>TOTAL</b></td><td><b>'+fm(totMin)+'</b></td><td><b>'+fm(totRec)+'</b></td></tr>'+
    '</tbody></table>'+
