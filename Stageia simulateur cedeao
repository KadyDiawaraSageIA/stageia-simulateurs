  <button class="tab" onclick="show(4)">📊 Marché</button>
  <button class="tab" onclick="show(5)">🗓️ Plan Action</button>
  <button class="tab" onclick="show(6)">⚠️ Risques</button>
</div>

<!-- PANE 0: PROFIL -->
<div class="pane on" id="p0">
  <div class="row">
    <div><label>Nom de votre entreprise</label><input id="entreprise" placeholder="Ex: Stageia, Boutique Aminata..." oninput="calc()"></div>
    <div><label>Secteur d'activité</label>
    <select id="secteur" onchange="calc()">
      <option value="tech">Tech / Digital / EdTech</option>
      <option value="commerce">Commerce / Distribution</option>
      <option value="services">Services aux entreprises</option>
      <option value="agroalim">Agroalimentaire / Agriculture</option>
      <option value="mode">Mode / Artisanat / Textile</option>
      <option value="sante">Santé / Pharmacie</option>
      <option value="formation">Formation / Éducation</option>
      <option value="finance">Finance / Fintech</option>
    </select></div>
  </div>
  <div class="row">
    <div><label>Stade de développement</label>
    <select id="stade" onchange="calc()">
      <option value="mvp">MVP / Prototype</option>
      <option value="local">Établi localement (Mali)</option>
      <option value="regional">Déjà présent dans 1 pays</option>
      <option value="multi">Multi-pays</option>
    </select></div>
    <div><label>Budget expansion disponible (FCFA)</label>
    <input type="number" id="budget" value="5000000" oninput="calc()"></div>
  </div>
  <div class="row">
    <div><label>CA mensuel actuel Mali (FCFA)</label>
    <input type="number" id="caMali" value="1000000" oninput="calc()"></div>
    <div><label>Objectif CA mensuel cible pays (FCFA)</label>
    <input type="number" id="caObjectif" value="2000000" oninput="calc()"></div>
  </div>
  <div class="row">
    <div><label>Taille équipe actuelle</label>
    <select id="equipe" onchange="calc()">
      <option value="1">Solo / 1-2 personnes</option>
      <option value="5">Petite équipe (3-10)</option>
      <option value="20">Équipe moyenne (11-50)</option>
      <option value="50">Grande équipe (50+)</option>
    </select></div>
    <div><label>Délai souhaité pour lancer (mois)</label>
    <input type="number" id="delai" value="6" min="1" max="24" oninput="calc()"></div>
  </div>
  <div class="kpis" id="kp0"></div>
  <div id="readiness"></div>
</div>

<!-- PANE 1: CHOISIR PAYS -->
<div class="pane" id="p1">
  <div class="box info">💡 Cliquez sur un ou plusieurs pays CEDEAO pour voir l'analyse détaillée. Commencez par 1 pays — maîtrisez-le avant de vous étendre.</div>
  <div class="pays-grid" id="paysGrid"></div>
  <div id="paysDetail"></div>
</div>

<!-- PANE 2: FORMALITÉS -->
<div class="pane" id="p2">
  <div id="formalitesBox"></div>
</div>

<!-- PANE 3: BUDGET -->
<div class="pane" id="p3">
  <div id="budgetBox"></div>
</div>

<!-- PANE 4: MARCHÉ -->
<div class="pane" id="p4">
  <div id="marcheBox"></div>
</div>

<!-- PANE 5: PLAN ACTION -->
<div class="pane" id="p5">
  <div id="planBox"></div>
</div>

<!-- PANE 6: RISQUES -->
<div class="pane" id="p6">
  <div id="risquesBox"></div>
</div>

