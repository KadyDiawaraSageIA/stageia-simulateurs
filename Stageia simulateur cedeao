      '<div style="padding:14px;display:grid;grid-template-columns:1fr 1fr;gap:12px">'+
      '<div><div style="font-size:11px;font-weight:700;color:#065F46;margin-bottom:6px">✅ Atouts</div>'+
      p.atouts.map(function(a){return '<div class="box" style="padding:5px 8px;font-size:11px;margin-bottom:4px">'+a+'</div>';}).join('')+
