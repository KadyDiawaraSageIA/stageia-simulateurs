function renderBudget(){
  var el=document.getElementById('budgetBox');
  if(!el) return;
  var budget=gn('budget',5000000);
  var pays=paysSelectionnes.length>0?PAYS.find(function(x){return x.id===paysSelectionnes[0];}):null;
  var budgetMin=pays?pays.budget_min:2000000;
  var budgetRec=pays?pays.budget_rec:8000000;
  var postes=[
    {poste:'Frais juridiques et immatriculation',min:300000,rec:800000,max:2000000},
    {poste:'Loyer bureau / espace de travail (6 mois)',min:500000,rec:1500000,max:4000000},
    {poste:'Recrutement et salaires (3 mois)',min:600000,rec:2000000,max:6000000},
    {poste:'Marketing et communication lancement',min:300000,rec:1000000,max:3000000},
    {poste:'Déplacements et missions terrain',min:400000,rec:800000,max:2000000},
    {poste:'Adaptation produit / tech',min:200000,rec:600000,max:2000000},
    {poste:'Fonds de roulement (trésorerie 3 mois)',min:500000,rec:1500000,max:5000000},
    {poste:'Imprévus (15% du total)',min:300000,rec:900000,max:2500000},
  ];
  var totMin=postes.reduce(function(s,p){return s+p.min;},0);
  var totRec=postes.reduce(function(s,p){return s+p.rec;},0);
  var statut=budget>=totRec?'ok':budget>=totMin?'warn':'err';
  var msg=budget>=totRec?'✅ Budget suffisant pour une expansion solide.':
