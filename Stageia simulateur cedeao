<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stageia — Développement International CEDEAO</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f0f0f0;padding:12px;color:#1a1a1a}
h1{background:linear-gradient(135deg,#0D0B2E,#065F46);color:#fff;padding:16px 20px;border-radius:10px;margin-bottom:14px;font-size:15px}
h1 small{display:block;font-size:11px;color:#6EE7B7;font-weight:400;margin-top:3px}
.tabs{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:14px}
.tab{padding:7px 13px;border:none;background:#ddd;color:#555;border-radius:7px;cursor:pointer;font-size:12px;font-family:Arial;font-weight:500}
.tab.on{background:#10B981;color:#fff}
.pane{display:none;background:#fff;border-radius:10px;padding:16px;border:1px solid #ddd}
.pane.on{display:block}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
label{font-size:11px;color:#666;font-weight:600;display:block;margin-bottom:4px}
input,select,textarea{width:100%;padding:8px 10px;border:1px solid #ccc;border-radius:7px;font-size:13px;font-family:Arial;background:#fff}
input:focus,select:focus,textarea:focus{outline:none;border-color:#10B981}
.hint{font-size:10px;color:#888;margin-top:3px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;margin:12px 0}
.kpi{background:#f5f5f5;border-radius:8px;padding:10px;text-align:center;border:1px solid #e0e0e0}
.kpi b{display:block;font-size:17px;color:#059669;margin-bottom:2px}
.kpi span{font-size:10px;color:#666}
.box{background:#ECFDF5;border-left:3px solid #10B981;border-radius:0 8px 8px 0;padding:10px 12px;margin-bottom:8px;font-size:12px;line-height:1.6}
.warn{background:#FEF3C7;border-left-color:#F59E0B;color:#92400E}
.err{background:#FEE2E2;border-left-color:#EF4444;color:#991B1B}
.info{background:#DBEAFE;border-left-color:#3B82F6;color:#1E40AF}
.purple{background:#F5F3FF;border-left-color:#8B5CF6;color:#5B21B6}
table{width:100%;border-collapse:collapse;font-size:11px;margin:10px 0}
th{background:#ECFDF5;padding:8px;text-align:left;font-weight:600;color:#065F46}
td{padding:8px;border-bottom:1px solid #eee}
tr.hl td{background:#ECFDF5;font-weight:700;color:#065F46}
.pays-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:12px 0}
.pays-card{border:2px solid #ddd;border-radius:10px;padding:12px;cursor:pointer;text-align:center;transition:all .15s}
.pays-card:hover{border-color:#10B981;transform:translateY(-2px)}
.pays-card.sel{border-color:#10B981;background:#ECFDF5}
.pays-flag{font-size:28px;margin-bottom:4px}
.pays-nom{font-size:12px;font-weight:700;margin-bottom:3px}
.pays-info{font-size:10px;color:#666;line-height:1.4}
.etape{border:1px solid #e0e0e0;border-radius:10px;overflow:hidden;margin-bottom:8px}
.etape-header{display:flex;align-items:center;gap:10px;padding:11px 14px;background:#f8f8f8;cursor:pointer}
.etape-num{width:28px;height:28px;border-radius:50%;background:#10B981;color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0}
.etape-title{font-size:13px;font-weight:600;flex:1}
.etape-dur{font-size:11px;color:#888}
.etape-body{padding:12px 14px;border-top:1px solid #eee;display:none}
.etape-body.open{display:block}
.etape-item{font-size:12px;padding:5px 0;border-bottom:1px solid #f5f5f5;display:flex;gap:8px;line-height:1.5}
.etape-item:last-child{border-bottom:none}
.bar-row{display:flex;align-items:center;gap:8px;margin-bottom:6px;font-size:11px}
.bar-lbl{width:120px;flex-shrink:0;color:#555}
.bar-track{flex:1;height:16px;background:#eee;border-radius:8px;overflow:hidden}
.bar-fill{height:100%;background:#10B981;border-radius:8px;display:flex;align-items:center;padding-left:6px;font-size:9px;color:#fff;font-weight:600}
.budget-table{width:100%;border-collapse:collapse;font-size:12px;margin:10px 0}
.budget-table th{background:#ECFDF5;padding:8px;font-weight:600;color:#065F46;text-align:left}
.budget-table td{padding:8px;border-bottom:1px solid #eee}
.budget-table tr.tot td{background:#ECFDF5;font-weight:700;color:#065F46}
@media(max-width:550px){.row{grid-template-columns:1fr}.pays-grid{grid-template-columns:1fr 1fr}}
</style>
</head>
