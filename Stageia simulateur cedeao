function show(i){
  document.querySelectorAll('.tab').forEach(function(t,j){t.classList.toggle('on',i===j);});
  document.querySelectorAll('.pane').forEach(function(p,j){p.classList.toggle('on',i===j);});
  calc();
}

function g(id,d){var e=document.getElementById(id);if(!e)return d||'';return e.value||d||'';}
function gn(id,d){return parseFloat(g(id))||d||0;}
function fm(n){return Math.round(n).toLocaleString('fr-FR');}

function togglePays(id){
  var idx=paysSelectionnes.indexOf(id);
  if(idx>=0) paysSelectionnes.splice(idx,1);
  else paysSelectionnes.push(id);
  renderPaysGrid();
  renderPaysDetail();
  calc();
}

function toggleEtape(i){
  etapesOpen[i]=!etapesOpen[i];
  renderPlan();
}

function renderPaysGrid(){
  var el=document.getElementById('paysGrid');
  if(!el) return;
  el.innerHTML=PAYS.map(function(p){
    var sel=paysSelectionnes.indexOf(p.id)>=0;
    var stars='';
    for(var i=0;i<5;i++) stars+=(i<Math.round(p.score/2)?'⭐':'☆');
    return '<div class="pays-card'+(sel?' sel':'')+'" onclick="togglePays(\''+p.id+'\')">'+
      '<div class="pays-flag">'+p.flag+'</div>'+
      '<div class="pays-nom">'+p.nom+'</div>'+
      '<div class="pays-info">'+p.pop+' hab. · '+p.pib+'<br>'+p.langue+' · '+p.monnaie+'<br>'+stars+'</div>'+
      '</div>';
  }).join('');
}

function renderPaysDetail(){
