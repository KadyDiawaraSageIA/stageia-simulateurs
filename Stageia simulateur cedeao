function calc(){
  var budget=gn('budget',5000000);
  var caMali=gn('caMali',1000000);
  var caObjectif=gn('caObjectif',2000000);
  var delai=gn('delai',6);
  var stade=g('stade','local');
  var score=0;
  if(stade==='local'||stade==='regional'||stade==='multi') score+=30;
  if(budget>=5000000) score+=25;
  if(caMali>=1000000) score+=20;
  if(delai>=6) score+=15;
  score=Math.min(100,score+10);

  var kp=document.getElementById('kp0');
  if(kp) kp.innerHTML=
    '<div class="kpi"><b>'+score+'%</b><span>Score readiness</span></div>'+
    '<div class="kpi"><b>'+fm(budget)+'</b><span>Budget dispo (F)</span></div>'+
    '<div class="kpi"><b>'+delai+' mois</b><span>Délai prévu</span></div>'+
    '<div class="kpi"><b>'+paysSelectionnes.length+'</b><span>Pays ciblés</span></div>';

  var rd=document.getElementById('readiness');
  if(rd){
    var cl=score>=70?'ok':score>=50?'warn':'err';
    var msg=score>=70?'✅ Vous êtes prêt(e) pour une expansion CEDEAO. Bonne préparation !':
            score>=50?'⚠️ Préparation partielle. Renforcez votre budget et votre expérience locale avant de vous lancer.':
            '❌ Trop tôt pour s\'internationaliser. Consolidez d\'abord votre position au Mali.';
    rd.innerHTML='<div class="box '+cl+'">'+msg+'</div>'+
      '<div class="box">💡 <b>Recommandation :</b> Commencez par le Sénégal ou la Côte d\'Ivoire — les marchés les plus accessibles et les plus rentables pour une PME malienne.</div>';
  }

  renderPaysGrid();
  renderPaysDetail();
  renderFormalites();
  renderBudget();
  renderMarche();
  renderPlan();
  renderRisques();
}

calc();
