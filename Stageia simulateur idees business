    '<div class="kpi"><b>'+ideesFiltrees.filter(function(i){return i.budget<=budget;}).length+'</b><span>Dans votre budget</span></div>'+
    '<div class="kpi"><b>'+Math.round(scored[0]?scored[0].score:0)+'%</b><span>Meilleur match</span></div>'+
    '<div class="kpi"><b>'+(ideesFiltrees[0]?ideesFiltrees[0].nom.split(' ').slice(0,2).join(' '):'—')+'</b><span>N°1 recommandé</span></div>';
}

function setFiltre(f){
  filtreCourant=f;
  document.querySelectorAll('.filtre-btn').forEach(function(b){b.classList.toggle('on',b.getAttribute('data-f')===f);});
  renderIdees();
}

function renderIdees(){
  var fb=document.getElementById('filtreBox');
  if(fb) fb.innerHTML=['tous','tech','education','food','mode','agriculture','sante','commerce','media'].map(function(f){
    var label={tous:'🔍 Tous',tech:'💻 Tech',education:'🎓 Formation',food:'🍽️ Food',mode:'👗 Mode',agriculture:'🌾 Agri',sante:'💊 Santé',commerce:'🏪 Commerce',media:'🎙️ Médias'}[f]||f;
    return '<button class="filtre-btn'+(filtreCourant===f?' on':'')+'" data-f="'+f+'" onclick="setFiltre(\''+f+'\')">'+label+'</button>';
  }).join('');

  var liste=filtreCourant==='tous'?ideesFiltrees:ideesFiltrees.filter(function(i){return i.secteur===filtreCourant;});
  var el=document.getElementById('ideasGrid');
  if(!el) return;
  if(liste.length===0){el.innerHTML='<div class="box warn">Aucune idée dans cette catégorie pour votre profil. Essayez "Tous".</div>';return;}
  el.innerHTML=liste.map(function(id,idx){
    var sc=scoreIdee(id);
    var sel=ideeSelectionnee&&ideeSelectionnee.id===id.id;
    return '<div class="idea-card'+(sel?' sel':'')+'" onclick="selIdee(\''+id.id+'\')">'+ 
      '<div class="idea-emoji">'+id.emoji+'</div>'+
      '<div class="idea-nom">'+(idx===0&&filtreCourant==='tous'?'⭐ ':'')+id.nom+'</div>'+
      '<div style="font-size:10px;color:#7C3AED;font-weight:600;margin-bottom:4px">Match : '+sc+'%</div>'+
      '<div class="score-bar"><div class="score-fill" style="width:'+sc+'%"></div></div>'+
      '<div class="idea-desc">'+id.desc+'</div>'+
      '<div class="idea-tags">'+id.tags.map(function(t){return '<span class="tag" style="background:#F5F3FF;color:#5B21B6">'+t+'</span>';}).join('')+'</div>'+
      '<div style="font-size:11px;color:#065F46;margin-top:6px;font-weight:500">💰 '+fm(id.revMin)+' — '+fm(id.revMax)+' F/mois</div>'+
      '</div>';
  }).join('');
}

function selIdee(id){
  ideeSelectionnee=TOUTES_IDEES.find(function(i){return i.id===id;});
  renderIdees();
  renderAnalyse();
  renderPlan();
}

function renderAnalyse(){
  var el=document.getElementById('analyseBox');
  if(!el) return;
  if(!ideeSelectionnee){el.innerHTML='<div class="box info">👆 Sélectionnez d\'abord une idée dans l\'onglet "Idées Générées".</div>';return;}
  var id=ideeSelectionnee;
  var sc=scoreIdee(id);
  el.innerHTML='<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;padding:14px;background:#F5F3FF;border-radius:10px">'+
    '<span style="font-size:36px">'+id.emoji+'</span>'+
    '<div><div style="font-size:16px;font-weight:700;color:#0D0B2E">'+id.nom+'</div>'+
    '<div style="font-size:12px;color:#666;margin-top:3px">'+id.desc+'</div></div>'+
    '</div>'+
    '<div class="kpis">'+
    '<div class="kpi"><b>'+sc+'%</b><span>Match profil</span></div>'+
    '<div class="kpi"><b>'+id.potentiel+'/10</b><span>Potentiel marché</span></div>'+
    '<div class="kpi"><b>'+id.difficulte+'/10</b><span>Difficulté</span></div>'+
    '<div class="kpi"><b>'+id.delai+' mois</b><span>Avant 1ers revenus</span></div>'+
    '<div class="kpi"><b>'+fm(id.revMin)+'</b><span>Revenu min (F)</span></div>'+
    '<div class="kpi"><b>'+fm(id.revMax)+'</b><span>Revenu max (F)</span></div>'+
    '</div>'+
    '<div class="section-title">✅ Avantages</div>'+
    id.avantages.map(function(a){return '<div class="box ok" style="margin-bottom:5px">✅ '+a+'</div>';}).join('')+
    '<div class="section-title">⚠️ Inconvénients</div>'+
    id.inconvenients.map(function(i){return '<div class="box warn" style="margin-bottom:5px">⚠️ '+i+'</div>';}).join('')+
    '<div class="section-title">💰 Sources de financement</div>'+
    id.financement.map(function(f){return '<div class="box info" style="margin-bottom:5px">🏦 '+f+'</div>';}).join('');
}

function renderCompar(){
  var el=document.getElementById('comparBox');
  if(!el) return;
  var top5=ideesFiltrees.slice(0,5);
  if(top5.length===0){el.innerHTML='<div class="box info">Générez d\'abord des idées dans l\'onglet Profil.</div>';return;}
  el.innerHTML='<div class="box info" style="margin-bottom:12px">📊 Comparaison des 5 meilleures idées pour votre profil.</div>'+
    '<table><thead><tr><th>Idée</th><th>Match</th><th>Potentiel</th><th>Difficulté</th><th>Budget min</th><th>Revenu max</th></tr></thead><tbody>'+
    top5.map(function(id,i){
      var sc=scoreIdee(id);
      return '<tr class="'+(i===0?'hl':'')+'"><td>'+id.emoji+' '+id.nom+'</td><td>'+sc+'%</td><td>'+id.potentiel+'/10</td><td>'+id.difficulte+'/10</td><td>'+fm(id.budget)+' F</td><td>'+fm(id.revMax)+' F</td></tr>';
    }).join('')+
    '</tbody></table>'+
    '<div class="box" style="margin-top:12px">💡 <b>Recommandation :</b> L\'idée n°1 '+top5[0].emoji+' <b>'+top5[0].nom+'</b> est la mieux adaptée à votre profil. Cliquez dessus dans "Idées Générées" pour l\'analyse complète.</div>';
}

function renderPlan(){
  var el=document.getElementById('planBox');
  if(!el) return;
  if(!ideeSelectionnee){el.innerHTML='<div class="box info">👆 Sélectionnez d\'abord une idée dans "Idées Générées".</div>';return;}
  var id=ideeSelectionnee;
  el.innerHTML='<div style="font-size:14px;font-weight:700;color:#0D0B2E;margin-bottom:12px">'+id.emoji+' Plan de démarrage — '+id.nom+'</div>'+
    '<div class="box" style="margin-bottom:12px">⏱️ <b>Délai avant premiers revenus :</b> '+id.delai+' mois · <b>Budget minimum :</b> '+fm(id.budget)+' FCFA</div>'+
    '<div class="section-title">📋 Étapes concrètes</div>'+
    id.etapes.map(function(e,i){
      return '<div style="display:flex;gap:10px;padding:9px 0;border-bottom:1px solid #f5f5f5">'+
        '<span style="width:24px;height:24px;border-radius:50%;background:#7C3AED;color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0">'+(i+1)+'</span>'+
        '<span style="font-size:12px;line-height:1.5">'+e+'</span></div>';
    }).join('')+
    '<div class="section-title">💰 Financement recommandé</div>'+
    id.financement.map(function(f){return '<div class="box info" style="margin-bottom:5px">🏦 '+f+'</div>';}).join('')+
    '<div class="section-title">📱 Actions immédiates cette semaine</div>'+
    '<div class="checklist-item"><span style="color:#7C3AED;font-size:16px">☐</span><span>Parler de cette idée à 5 personnes de votre entourage — recueillez leurs réactions</span></div>'+
    '<div class="checklist-item"><span style="color:#7C3AED;font-size:16px">☐</span><span>Chercher 3 concurrents existants et analyser leurs prix et services</span></div>'+
    '<div class="checklist-item"><span style="color:#7C3AED;font-size:16px">☐</span><span>Identifier votre 1er client potentiel et le contacter cette semaine</span></div>'+
    '<div class="checklist-item"><span style="color:#7C3AED;font-size:16px">☐</span><span>Calculer précisément votre budget de démarrage réel</span></div>'+
    '<div class="checklist-item"><span style="color:#7C3AED;font-size:16px">☐</span><span>Rejoindre 2 groupes Facebook d\'entrepreneurs maliens pour votre secteur</span></div>';
}

function renderTendances(){
  var el=document.getElementById('tendancesBox');
  if(!el) return;
  var tendances=[
    {emoji:'☀️',titre:'Énergie Solaire',score:10,desc:'Délestage chronique + gouvernement pro-solaire = marché de 10 milliards FCFA/an. Croissance +40%/an.'},
    {emoji:'📱',titre:'Mobile Money & Fintech',score:10,desc:'70% non-bancarisés. Orange Money + Moov = infrastructure. Fintech est le secteur le plus chaud de la CEDEAO.'},
    {emoji:'🎓',titre:'Formation Digitale',score:9,desc:'1 million de jeunes diplômés sans emploi numérique. EdTech = secteur à impact et à croissance. POESAM prioritaire.'},
    {emoji:'🛵',titre:'Livraison / Logistique',score:9,desc:'E-commerce naissant = besoin livraison. Bamako saturée en trafic = opportunité livraison vélo/moto.'},
    {emoji:'🌾',titre:'Agro-transformation',score:9,desc:'Mali produit énormément mais transforme peu. Jus de fruits, farines locales, conserves = valeur ajoutée × 5.'},
    {emoji:'🏗️',titre:'Construction / BTP',score:8,desc:'Urbanisation rapide de Bamako (+5%/an). Matériaux locaux, finitions, rénovation = marché immense.'},
    {emoji:'💻',titre:'Tech / SaaS pour PME',score:8,desc:'Les PME maliennes cherchent des logiciels simples (caisse, stock, RH). Peu d\'offres locales adaptées.'},
    {emoji:'🏥',titre:'Santé / Télémédecine',score:8,desc:'Déficit médical fort. Téléconsultation, pharmacies en ligne, diagnostic mobile = secteur d\'avenir.'},
    {emoji:'🎨',titre:'Économie Créative',score:7,desc:'Musique, art, design, mode africaine. Exportable internationalement. NFT et marchés numériques émergents.'},
    {emoji:'♻️',titre:'Recyclage / Environnement',score:7,desc:'Bamako produit 1 500 tonnes de déchets/jour. Peu de recyclage organisé. Subventions ONU disponibles.'},
  ];
  el.innerHTML='<div class="box info" style="margin-bottom:12px">🔥 Secteurs en forte croissance au Mali en 2025. Basé sur les données marché, les financements disponibles et la demande terrain.</div>'+
    tendances.map(function(t){
      var bars='';
      for(var i=0;i<10;i++) bars+='<span style="display:inline-block;width:14px;height:14px;border-radius:2px;margin-right:2px;background:'+(i<t.score?'#7C3AED':'#e0e0e0')+'"></span>';
      return '<div style="border:1px solid #e0e0e0;border-radius:10px;padding:12px;margin-bottom:8px">'+
        '<div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">'+
        '<span style="font-size:22px">'+t.emoji+'</span>'+
        '<div><div style="font-size:13px;font-weight:700">'+t.titre+'</div>'+
        '<div style="margin-top:3px">'+bars+'</div></div>'+
        '</div>'+
        '<div style="font-size:12px;color:#444;line-height:1.5">'+t.desc+'</div>'+
        '</div>';
    }).join('');
}

genIdees();
</script>
