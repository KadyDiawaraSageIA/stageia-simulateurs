function show(i){
  document.querySelectorAll('.tab').forEach(function(t,j){t.classList.toggle('on',i===j);});
  document.querySelectorAll('.pane').forEach(function(p,j){p.classList.toggle('on',i===j);});
  if(i===1) renderIdees();
  if(i===2) renderAnalyse();
  if(i===3) renderCompar();
  if(i===4) renderPlan();
  if(i===5) renderTendances();
}

function g(id,d){var e=document.getElementById(id);if(!e)return d||'';return e.value||d||'';}
function gn(id,d){return parseFloat(g(id))||d||0;}
function fm(n){return Math.round(n).toLocaleString('fr-FR');}

function scoreIdee(idee){
  var budget=gn('budget',0);
  var comp=g('competences','tech');
  var passion=g('passion','tech');
  var ville=g('ville','bamako');
  var temps=g('temps','plein');
  var score=0;
  if(idee.budget<=budget||(budget===0&&idee.budget===0)) score+=25;
  else if(idee.budget<=budget*2) score+=10;
  if(idee.competences.indexOf(comp)>=0) score+=20;
  if(idee.passion.indexOf(passion)>=0) score+=15;
  if(idee.villes.indexOf(ville)>=0||idee.villes.indexOf('autre')>=0) score+=20;
  if(temps==='plein') score+=10;
  else if(temps==='partiel'&&idee.difficulte<=5) score+=10;
  score+=idee.potentiel;
  return Math.min(100,score);
}

function genIdees(){
  var scored=TOUTES_IDEES.map(function(id){
    return {idee:id,score:scoreIdee(id)};
  });
  scored.sort(function(a,b){return b.score-a.score;});
  ideesFiltrees=scored.map(function(s){return s.idee;});
  var budget=gn('budget',0);
  var nb=ideesFiltrees.length;
  var kp=document.getElementById('kp0');
